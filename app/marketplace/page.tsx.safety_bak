export interface BulkPricingTier {
  tierName: string;
  moq: number;
  unitPrice: number;
  badge: string;
}

export interface ProductItem {
  id: string;
  title: string;
  category:
    | "Auto Parts"
    | "Beauty & Personal Care"
    | "Electronics & Tech"
    | "Fashion & Footwear"
    | "Machinery & Tools"
    | "Salon & Spa"
    | "Packaging & Supplies"
    | "Wellness & Vitality"
    | "Smart Home & Decor"
    | "Kitchen & Snacks";
  country: "TH" | "CN" | "VN" | "KR" | "JP" | "KH";
  countryName: string;
  flag: string;
  supplierCity: string;
  logisticsPartner: "VET Express" | "J&T Express" | "ZTO Express" | "Air Cargo";
  logisticsRoute: string;
  imageUrl: string;
  stockLeft: number;
  isLiveTikTok: boolean;
  retailPrice: number;
  resellerTier: BulkPricingTier;
  cartonTier: BulkPricingTier;
}

