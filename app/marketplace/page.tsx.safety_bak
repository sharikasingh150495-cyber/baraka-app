    supplierCity: "Siem Reap / Battambang Hub",
    logisticsPartner: "J&T Express",
    logisticsRoute: "J&T Express 2h Instant Dispatch across Phnom Penh",
    imageUrl: "https://images.unsplash.com/photo-1544025162-d76694265947?w=600&q=80",
