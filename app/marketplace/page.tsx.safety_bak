    isLiveTikTok: true,
    retailPrice: 12.0,
    resellerTier: { tierName: "Local Deli Pack", moq: 6, unitPrice: 7.5, badge: "Province Favorite" },
    cartonTier: { tierName: "Wholesale Master Bale", moq: 40, unitPrice: 5.4, badge: "Direct Origin Price" },
  },
];

const COUNTRIES_BAR = [
  { code: "ALL", labelKey: "filterAll", flag: "🌐" },
  { code: "TH", label: "Thailand", flag: "🇹🇭" },
  { code: "CN", label: "China", flag: "🇨🇳" },
  { code: "VN", label: "Vietnam", flag: "🇻🇳" },
  { code: "KR", label: "South Korea", flag: "🇰🇷" },
  { code: "JP", label: "Japan", flag: "🇯🇵" },
  { code: "KH", label: "Cambodia Hub", flag: "🇰🇭" },
] as const;

const AVAILABLE_LANGUAGES: { code: LanguageCode; label: string; flag: string }[] = [
  { code: "KM", label: "ភាសាខ្មែរ (Khmer)", flag: "🇰🇭" },
  { code: "EN", label: "English (EN)", flag: "🇬🇧" },
  { code: "ZH", label: "中文 (Chinese)", flag: "🇨🇳" },
  { code: "TH", label: "ไทย (Thai)", flag: "🇹🇭" },
  { code: "VI", label: "Tiếng Việt (Viet)", flag: "🇻🇳" },
  { code: "KO", label: "한국어 (Korean)", flag: "🇰🇷" },
  { code: "JA", label: "日本語 (Japanese)", flag: "🇯🇵" },
];

const RECENT_LIVE_PURCHASES = [
  { buyer: "Bopha S.", market: "Olympic Market, Phnom Penh", item: "Osaka Chronograph Watches", qty: "10 Pcs Carton", time: "just now" },
  { buyer: "Sokha Chen", market: "Orussey Market Hub", item: "Bangkok Air-Cushion Sneakers", qty: "50 Pairs Master Bale", time: "18s ago" },
  { buyer: "Meng V.", market: "Battambang Central Store", item: "2-in-1 Shabu Hotpot Grills", qty: "10 Pcs Pack", time: "42s ago" },
  { buyer: "Dany K.", market: "Tuol Kork Boutique", item: "Korean Puffer Cloud Bags", qty: "80 Pcs Master Bale", time: "1m ago" },
  { buyer: "Chanthy L.", market: "Siem Reap Night Market", item: "Cyberpunk TWS Earbuds", qty: "100 Pcs Master Crate", time: "2m ago" },
];

export default function MarketplacePage() {
  const [currentLang, setCurrentLang] = useState<LanguageCode>("KM");
  const [selectedCountry, setSelectedCountry] = useState<string>("ALL");
  const [activeProduct, setActiveProduct] = useState<ProductItem>(ALL_MASTER_PRODUCTS[0]);
  const [selectedTier, setSelectedTier] = useState<"retail" | "reseller" | "carton">("reseller");
  const [expressPass, setExpressPass] = useState(true);
  const [showKhqrModal, setShowKhqrModal] = useState(false);
  const [paymentStatus, setPaymentStatus] = useState<"IDLE" | "SUCCESS">("IDLE");

  const [activeViewers, setActiveViewers] = useState(38);
  const [timeLeft, setTimeLeft] = useState({ minutes: 14, seconds: 28 });
  const [recentToastIndex, setRecentToastIndex] = useState(0);

  const t = UI_TRANSLATIONS[currentLang] || UI_TRANSLATIONS.EN;

  useEffect(() => {
    const timer = setInterval(() => {
      setTimeLeft((prev) => {
        if (prev.seconds > 0) return { ...prev, seconds: prev.seconds - 1 };
        if (prev.minutes > 0) return { minutes: prev.minutes - 1, seconds: 59 };
        return { minutes: 14, seconds: 59 };
      });
    }, 1000);
    return () => clearInterval(timer);
  }, []);

  useEffect(() => {
    const interval = setInterval(() => {
      setRecentToastIndex((prev) => (prev + 1) % RECENT_LIVE_PURCHASES.length);
      setActiveViewers((prev) => Math.floor(Math.random() * 15) + 32);
    }, 6500);
    return () => clearInterval(interval);
  }, []);

  const filteredProducts =
    selectedCountry === "ALL"
      ? ALL_MASTER_PRODUCTS
      : ALL_MASTER_PRODUCTS.filter((p) => p.country === selectedCountry);

  const getPricingInfo = () => {
    if (selectedTier === "retail") {
      return { qty: 1, unitPrice: activeProduct.retailPrice, label: t.retailSample };
    }
    if (selectedTier === "reseller") {
      return {
        qty: activeProduct.resellerTier.moq,
        unitPrice: activeProduct.resellerTier.unitPrice,
        label: `${activeProduct.resellerTier.moq} Pcs (${activeProduct.resellerTier.tierName})`,
      };
    }
    return {
      qty: activeProduct.cartonTier.moq,
      unitPrice: activeProduct.cartonTier.unitPrice,
      label: `${activeProduct.cartonTier.moq} Pcs (${activeProduct.cartonTier.tierName})`,
    };
  };

  const currentOrder = getPricingInfo();
  const subtotal = currentOrder.qty * currentOrder.unitPrice;
  const speedPassFee = expressPass ? 0.4 : 0.0;
  const totalAmount = subtotal + speedPassFee;
  const sampleComparisonTotal = currentOrder.qty * activeProduct.retailPrice;
  const totalSaved = sampleComparisonTotal - subtotal;

  const getTrackingDetails = () => {
    const randomCode = Math.floor(100000 + Math.random() * 900000);
    if (activeProduct.logisticsPartner === "ZTO Express" || activeProduct.country === "CN") {
      return { code: `ZTO-KH-${randomCode}`, carrier: "ZTO Express Air/Sea Cargo" };
    }
    if (activeProduct.logisticsPartner === "J&T Express" || activeProduct.country === "KH") {
      return { code: `JT-KH-${randomCode}`, carrier: "J&T Express Door-to-Door" };
    }
    return { code: `VET-KH-${randomCode}`, carrier: "VET Express Border Shuttle" };
  };

  const trackingInfo = getTrackingDetails();
  const currentToast = RECENT_LIVE_PURCHASES[recentToastIndex];

  return (
    <main className="min-h-screen bg-neutral-950 text-neutral-100 p-3 sm:p-6 pb-28 antialiased font-sans relative select-none">
      {/* 🔴 LIVE PSYCHOLOGY: Top Ticker */}
      <div className="max-w-7xl mx-auto mb-4 bg-gradient-to-r from-red-950/80 via-neutral-900 to-red-950/80 border border-red-500/30 rounded-2xl px-4 py-2 flex flex-wrap items-center justify-between text-xs gap-2 shadow-lg shadow-red-950/20">
        <div className="flex items-center gap-2">
          <span className="relative flex h-2.5 w-2.5">
            <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
            <span className="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500"></span>
          </span>
          <span className="font-black text-red-400 uppercase tracking-wide">{t.liveDesk}</span>
          <span className="text-neutral-200 font-semibold">{t.activeMerchants}</span>
        </div>
        <div className="flex items-center gap-3 text-neutral-400">
          <span>⚡ {t.borderPassOpen}</span>
          <span className="hidden sm:inline">•</span>
          <span className="hidden sm:inline">{t.nextShuttle}</span>
        </div>
      </div>

      {/* Top Header with Multi-Language Switcher */}
      <header className="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-neutral-800 pb-5 mb-6">
        <div>
          <div className="flex items-center gap-2">
            <Link
              href="/"
              className="w-8 h-8 rounded-full bg-neutral-900 border border-neutral-700 flex items-center justify-center text-white text-base font-bold active:scale-90 transition-transform shrink-0"
              aria-label="Back to Home"
            >
              ←
            </Link>
            <h1 className="text-xl sm:text-3xl font-black tracking-tight text-white">
              BARAKA <span className="text-red-500">WHOLESALE</span>
            </h1>
            <span className="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold">
              Bakong Universal KHQR Escrow
            </span>
          </div>
          <p className="text-xs sm:text-sm text-neutral-400 mt-1">{t.tagline}</p>
        </div>

        <div className="flex flex-wrap items-center gap-3">
          {/* 🌐 7-Language Switcher Dropdown */}
          <div className="relative flex items-center bg-neutral-900 border border-neutral-700 rounded-xl px-2.5 py-1.5 shadow-md">
            <span className="text-sm mr-1.5">🌐</span>
            <select
              value={currentLang}
              onChange={(e) => setCurrentLang(e.target.value as LanguageCode)}
              aria-label="Select Language"
              className="bg-transparent text-xs font-bold text-white focus:outline-none cursor-pointer pr-1"
            >
              {AVAILABLE_LANGUAGES.map((lang) => (
                <option key={lang.code} value={lang.code} className="bg-neutral-900 text-neutral-100">
                  {lang.flag} {lang.label}
                </option>
              ))}
            </select>
          </div>

          <a
            href="https://t.me/"
            target="_blank"
            rel="noreferrer"
            className="flex items-center gap-2 px-3 py-2 rounded-xl bg-sky-500/10 border border-sky-500/30 text-sky-400 text-xs font-semibold hover:bg-sky-500/20 transition-all"
          >
            <span>💬</span> {t.vipDesk}
          </a>
          <div className="px-3 py-2 rounded-xl bg-neutral-900 border border-neutral-800 text-xs text-neutral-300">
            🚚 {t.logisticsBadge}
          </div>
        </div>
      </header>

      {/* 6 Country Filter Bar */}
      <div className="max-w-7xl mx-auto mb-6">
        <div className="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
          {COUNTRIES_BAR.map((c) => (
            <button
              key={c.code}
              onClick={() => setSelectedCountry(c.code)}
              className={`flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all ${
                selectedCountry === c.code
                  ? "bg-red-600 text-white shadow-lg shadow-red-600/30 border border-red-500"
                  : "bg-neutral-900 text-neutral-400 border border-neutral-800 hover:border-neutral-700 hover:text-neutral-200"
              }`}
            >
              <span>{c.flag}</span>
              <span>{c.code === "ALL" ? t.filterAll : c.label}</span>
            </button>
          ))}
        </div>
      </div>

      {/* Grid: Catalog (Left) + Checkout Panel (Right) */}
      <div className="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-6">
        {/* Products Grid */}
        <div className="lg:col-span-8 space-y-4">
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {filteredProducts.map((p) => {
              const isSelected = activeProduct.id === p.id;
              return (
                <div
                  key={p.id}
                  onClick={() => {
                    setActiveProduct(p);
                    setPaymentStatus("IDLE");
                  }}
                  className={`cursor-pointer rounded-2xl p-4 transition-all border relative flex flex-col justify-between ${
                    isSelected
                      ? "bg-neutral-900 border-red-500 shadow-xl shadow-red-950/40"
                      : "bg-neutral-900/60 border-neutral-800/80 hover:border-neutral-700"
                  }`}
                >
                  <div>
                    <div className="flex items-center justify-between mb-2">
                      <span className="text-[11px] font-bold px-2 py-0.5 rounded-md bg-neutral-800 border border-neutral-700 text-neutral-300 flex items-center gap-1">
                        <span>{p.flag}</span> {p.countryName}
                      </span>
                      {p.isLiveTikTok && (
                        <span className="text-[10px] font-black px-2 py-0.5 rounded-md bg-red-500/20 border border-red-500/40 text-red-400 animate-pulse flex items-center gap-1">
                          <span className="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                          {t.tiktokHit}
                        </span>
                      )}
                    </div>

                    <div className="relative w-full h-40 rounded-xl overflow-hidden mb-3 bg-neutral-800">
                      <Image
                        src={p.imageUrl}
                        alt={p.title}
                        fill
                        className="object-cover group-hover:scale-105 transition-transform"
                        unoptimized
                      />
                      <span className="absolute bottom-2 left-2 bg-black/80 backdrop-blur-sm text-[10px] font-bold text-amber-400 px-2 py-0.5 rounded-md border border-amber-500/30">
                        {t.highDemand}
                      </span>
                    </div>

                    <h3 className="text-sm font-bold text-white line-clamp-2 mb-1">{p.title}</h3>
                    <p className="text-[11px] text-neutral-400 mb-3 flex items-center gap-1">
                      <span>🚚</span> <span className="font-semibold text-neutral-300">{p.logisticsPartner}:</span> {p.logisticsRoute}
                    </p>
                  </div>

                  <div className="bg-neutral-950/80 rounded-xl p-2.5 border border-neutral-800/80 space-y-1.5">
                    <div className="flex items-center justify-between text-[11px]">
                      <span className="text-neutral-500">{t.retailSample}:</span>
                      <span className="font-semibold text-neutral-300">${p.retailPrice.toFixed(2)}/pc</span>
                    </div>
                    <div className="flex items-center justify-between text-xs">
                      <span className="text-amber-400 font-semibold">{p.resellerTier.tierName} ({p.resellerTier.moq}+ pcs):</span>
                      <span className="font-bold text-amber-300">${p.resellerTier.unitPrice.toFixed(2)}/pc</span>
                    </div>
                    <div className="flex items-center justify-between text-xs border-t border-neutral-800/60 pt-1">
                      <span className="text-emerald-400 font-bold">{t.cartonSub} ({p.cartonTier.moq}+ pcs):</span>
                      <span className="font-black text-emerald-300">${p.cartonTier.unitPrice.toFixed(2)}/pc</span>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Right Checkout Panel */}
        <div className="lg:col-span-4">
          <div className="sticky top-6 bg-neutral-900 border border-neutral-800 rounded-3xl p-5 space-y-5 shadow-2xl">
            {/* Live Psychology Urgency Banner */}
            <div className="bg-red-950/30 border border-red-500/30 rounded-2xl p-3 space-y-2">
              <div className="flex items-center justify-between text-xs">
                <span className="flex items-center gap-1.5 text-amber-300 font-bold">
                  <span>🔥</span> {activeViewers} {t.viewingNow}
                </span>
                <span className="font-mono text-xs font-bold text-red-400 bg-red-500/10 px-2 py-0.5 rounded-md border border-red-500/20">
                  ⏳ {String(timeLeft.minutes).padStart(2, "0")}:{String(timeLeft.seconds).padStart(2, "0")}
                </span>
              </div>

              <div className="space-y-1">
                <div className="flex justify-between text-[10px] text-neutral-400">
                  <span>{t.batchFloorRate}</span>
                  <span className="text-amber-400 font-bold">{t.claimedLabel}</span>
                </div>
                <div className="w-full h-1.5 bg-neutral-800 rounded-full overflow-hidden">
                  <div className="h-full bg-gradient-to-r from-amber-500 to-red-500 rounded-full w-[84%]"></div>
                </div>
                <p className="text-[10px] text-neutral-500 text-right">{t.cartonsLeft}</p>
              </div>
            </div>

            {/* Selected Product Header */}
            <div className="flex gap-3 items-center border-b border-neutral-800 pb-4">
              <div className="relative w-16 h-16 rounded-xl overflow-hidden bg-neutral-800 shrink-0">
                <Image
                  src={activeProduct.imageUrl}
                  alt={activeProduct.title}
                  fill
                  className="object-cover"
                  unoptimized
                />
              </div>
              <div>
                <span className="text-[10px] font-bold px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-300">
                  {activeProduct.flag} {activeProduct.supplierCity}
                </span>
                <h4 className="text-xs font-bold text-white line-clamp-2 mt-1">{activeProduct.title}</h4>
              </div>
            </div>

            <div>
              <label className="text-xs font-bold text-neutral-300 block mb-2">{t.selectTier}</label>
              <div className="space-y-2">
                {/* 1 Pc Sample */}
                <button
                  onClick={() => setSelectedTier("retail")}
                  className={`w-full p-2.5 rounded-xl border text-left flex items-center justify-between transition-all ${
                    selectedTier === "retail"
                      ? "border-neutral-400 bg-neutral-800"
                      : "border-neutral-800 bg-neutral-950/60 text-neutral-400 hover:border-neutral-700"
                  }`}
                >
                  <div>
                    <p className="text-xs font-bold text-white">{t.retailSample}</p>
                    <p className="text-[10px] text-neutral-500">{t.retailSub}</p>
                  </div>
                  <div className="text-right">
                    <p className="text-xs font-bold text-white">${activeProduct.retailPrice.toFixed(2)}</p>
                    <span className="text-[9px] text-neutral-500">{t.retailRate}</span>
                  </div>
                </button>

                {/* Reseller MOQ */}
                <button
                  onClick={() => setSelectedTier("reseller")}
                  className={`w-full p-2.5 rounded-xl border text-left flex items-center justify-between transition-all ${
                    selectedTier === "reseller"
                      ? "border-amber-500 bg-amber-500/10"
                      : "border-neutral-800 bg-neutral-950/60 text-neutral-400 hover:border-neutral-700"
                  }`}
                >
                  <div>
                    <div className="flex items-center gap-1.5">
                      <p className="text-xs font-bold text-amber-300">{activeProduct.resellerTier.tierName}</p>
                      <span className="text-[9px] px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 font-bold">
                        MOQ {activeProduct.resellerTier.moq}
                      </span>
                    </div>
                    <p className="text-[10px] text-neutral-400">{t.resellerSub}</p>
                  </div>
                  <div className="text-right">
                    <p className="text-xs font-bold text-amber-300">${activeProduct.resellerTier.unitPrice.toFixed(2)}/pc</p>
                    <span className="text-[9px] text-emerald-400 font-semibold">
                      Save ${(activeProduct.retailPrice - activeProduct.resellerTier.unitPrice).toFixed(2)}/pc
                    </span>
                  </div>
                </button>

                {/* Master Carton Wholesale */}
                <button
                  onClick={() => setSelectedTier("carton")}
                  className={`w-full p-2.5 rounded-xl border text-left flex items-center justify-between transition-all ${
                    selectedTier === "carton"
                      ? "border-emerald-500 bg-emerald-500/10 shadow-lg shadow-emerald-950/30"
                      : "border-neutral-800 bg-neutral-950/60 text-neutral-400 hover:border-neutral-700"
                  }`}
                >
                  <div>
                    <div className="flex items-center gap-1.5">
                      <p className="text-xs font-bold text-emerald-300">{activeProduct.cartonTier.tierName} ★</p>
                      <span className="text-[9px] px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-300 font-bold">
                        MOQ {activeProduct.cartonTier.moq}
                      </span>
                    </div>
                    <p className="text-[10px] text-neutral-400">{t.cartonSub}</p>
                  </div>
                  <div className="text-right">
                    <p className="text-xs font-bold text-emerald-300">${activeProduct.cartonTier.unitPrice.toFixed(2)}/pc</p>
                    <span className="text-[9px] text-emerald-400 font-bold">{t.factoryBottom}</span>
                  </div>
                </button>
              </div>
            </div>

            {/* Fast-Pass Toggle */}
            <div className="flex items-center justify-between p-3 rounded-xl bg-neutral-950 border border-neutral-800">
              <div className="space-y-0.5">
                <p className="text-xs font-bold text-neutral-200">{t.fastPassTitle}</p>
                <p className="text-[10px] text-neutral-400">{t.fastPassSub}</p>
              </div>
              <input
                type="checkbox"
                checked={expressPass}
                onChange={(e) => setExpressPass(e.target.checked)}
                className="w-4 h-4 accent-red-600 rounded cursor-pointer"
              />
            </div>

            {/* Price Calculations */}
            <div className="space-y-2 border-t border-neutral-800 pt-3 text-xs">
              <div className="flex justify-between text-neutral-400">
                <span>{t.selectedOrder} ({currentOrder.label}):</span>
                <span className="text-neutral-200 font-semibold">${subtotal.toFixed(2)}</span>
              </div>
              <div className="flex justify-between text-neutral-400">
                <span>{t.logisticsFee}</span>
                <span className="text-neutral-200 font-semibold">${speedPassFee.toFixed(2)}</span>
              </div>
              <div className="flex justify-between text-neutral-400">
                <span>{t.escrowBadge}</span>
                <span className="text-emerald-400 font-bold">{t.escrowFree}</span>
              </div>
              {totalSaved > 0 && (
                <div className="flex justify-between text-emerald-400 font-bold bg-emerald-950/40 p-2 rounded-lg border border-emerald-900/50">
                  <span>{t.marginSaved}</span>
                  <span>-${totalSaved.toFixed(2)}</span>
                </div>
              )}
              <div className="flex justify-between text-sm font-extrabold text-white border-t border-neutral-800 pt-2">
                <span>{t.totalDue}</span>
                <span className="text-base text-red-400">${totalAmount.toFixed(2)}</span>
              </div>
            </div>

            {/* Checkout Action */}
            <button
              onClick={() => {
                setShowKhqrModal(true);
                setPaymentStatus("IDLE");
              }}
              className="w-full py-3.5 rounded-2xl bg-red-600 hover:bg-red-500 active:scale-[0.98] text-white font-bold text-sm shadow-xl shadow-red-600/30 transition-all flex items-center justify-center gap-2"
            >
              <span>🇰🇭</span> {t.payKhqr} (${totalAmount.toFixed(2)})
            </button>

            <p className="text-[10px] text-center text-neutral-500">{t.escrowPromise}</p>
          </div>
        </div>
      </div>

      {/* Floating Social Proof Toast */}
      <div className="fixed bottom-20 left-4 z-40 max-w-xs bg-neutral-900/95 backdrop-blur-md border border-red-500/30 rounded-2xl p-3 shadow-2xl transition-all duration-500 flex items-center gap-3">
        <div className="w-9 h-9 rounded-full bg-red-600/20 border border-red-500/40 flex items-center justify-center text-base shrink-0">
          🛍️
        </div>
        <div className="text-xs">
          <p className="font-bold text-white leading-tight">
            {currentToast.buyer} <span className="text-[10px] font-normal text-neutral-400">({currentToast.market})</span>
          </p>
          <p className="text-[11px] text-amber-300 font-semibold mt-0.5">
            Locked {currentToast.qty} of {currentToast.item}
          </p>
          <p className="text-[9px] text-neutral-500 mt-0.5">Verified Bakong Escrow • {currentToast.time}</p>
        </div>
      </div>

      {/* Bakong KHQR Modal */}
      {showKhqrModal && (
        <div className="fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-neutral-900 border border-neutral-800 rounded-3xl p-6 max-w-sm w-full space-y-4 shadow-2xl relative">
            <button
              onClick={() => setShowKhqrModal(false)}
              className="absolute top-4 right-4 text-neutral-400 hover:text-white text-lg font-bold"
            >
              ✕
            </button>

            <div className="text-center space-y-1">
              <span className="text-2xl">🇰🇭</span>
              <h3 className="text-lg font-black text-white">Bakong KHQR Universal</h3>
              <p className="text-xs text-neutral-400">{t.scanHelp}</p>
            </div>

            {paymentStatus === "IDLE" ? (
              <div className="space-y-4">
                <div className="bg-white p-4 rounded-2xl mx-auto w-48 h-48 flex flex-col items-center justify-center shadow-inner relative">
                  <div className="w-full h-full border-4 border-dashed border-neutral-400 rounded-xl flex flex-col items-center justify-center text-neutral-800 text-center p-2">
                    <span className="text-3xl font-black mb-1">KHQR</span>
                    <span className="text-[11px] font-bold text-red-600">BAKONG ESCROW</span>
                    <span className="text-[10px] text-neutral-600 mt-1">${totalAmount.toFixed(2)} USD</span>
                  </div>
                </div>

                <div className="text-center space-y-1">
                  <p className="text-xs font-bold text-neutral-200">Total: ${totalAmount.toFixed(2)} USD</p>
                  <p className="text-[10px] text-neutral-500">
                    Carrier Assigned: <span className="text-neutral-300 font-semibold">{activeProduct.logisticsPartner}</span>
                  </p>
                </div>

                <button
                  onClick={() => setPaymentStatus("SUCCESS")}
                  className="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center gap-1.5 cursor-pointer"
                >
                  <span>⚡</span> {t.simulatePay}
                </button>
              </div>
            ) : (
              <div className="text-center space-y-3 py-4">
                <div className="w-14 h-14 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto text-2xl border border-emerald-500/40">
                  ✓
                </div>
                <h4 className="text-base font-bold text-white">{t.paymentLocked}</h4>
                <p className="text-xs text-neutral-400">{t.paymentSuccessDesc}</p>
                <div className="p-3 bg-neutral-950 rounded-xl border border-neutral-800 text-left text-xs space-y-1.5">
                  <p className="text-neutral-400">{t.carrierLabel} <span className="text-white font-semibold">{trackingInfo.carrier}</span></p>
                  <p className="text-neutral-400">{t.trackingLabel} <span className="text-emerald-400 font-mono font-bold">{trackingInfo.code}</span></p>
                  <p className="text-neutral-400">{t.statusLabel} <span className="text-amber-400 font-semibold">{t.statusApproved}</span></p>
                </div>
                <button
                  onClick={() => setShowKhqrModal(false)}
                  className="w-full py-2.5 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-white text-xs font-semibold cursor-pointer"
                >
                  {t.doneBtn}
                </button>
              </div>
            )}
          </div>
        </div>
      )}

      {/* Bottom Mobile Navigation Bar */}
      <nav className="fixed bottom-0 left-0 right-0 z-40 bg-neutral-950/90 backdrop-blur-md border-t border-neutral-800 py-2.5 px-6">
        <div className="max-w-md mx-auto flex items-center justify-between text-xs">
          <Link href="/marketplace" className="flex flex-col items-center gap-1 text-red-500 font-bold">
            <span className="text-lg">🛒</span>
            <span>{t.navMarket}</span>
          </Link>
          <Link href="/feed" className="flex flex-col items-center gap-1 text-neutral-400 hover:text-white transition-colors">
            <span className="text-lg">📱</span>
            <span>{t.navFeed}</span>
          </Link>
          <Link href="/studio" className="flex flex-col items-center gap-1 text-neutral-400 hover:text-white transition-colors">
            <span className="text-lg">🎬</span>
            <span>{t.navStudio}</span>
          </Link>
          <Link href="/wallet" className="flex flex-col items-center gap-1 text-neutral-400 hover:text-white transition-colors">
            <span className="text-lg">💳</span>
            <span>{t.navWallet}</span>
          </Link>
        </div>
      </nav>
    </main>
  );
}